diff -ru a/libfprint/fpi-sdcp.c b/libfprint/fpi-sdcp.c
--- a/libfprint/fpi-sdcp.c	2026-10-23 00:03:45.891628753 +0900
+++ b/libfprint/fpi-sdcp.c	2026-10-23 00:23:29.384057146 +0900
@@ -48,7 +48,7 @@
   e = ERR_get_error ();
   while (e != 0)
     {
-      fp_dbg ("OpenSSL error: %s", ERR_error_string (e, NULL));
+      fp_warn ("OpenSSL error: %s", ERR_error_string (e, NULL));
       e = ERR_get_error ();
     }
 }
@@ -432,12 +432,14 @@
   if (!EVP_PKEY_get_bn_param (pkey, OSSL_PKEY_PARAM_PRIV_KEY, &priv_bn))
     goto out_error;
 
-  priv_len = BN_num_bytes (priv_bn);
-  if (priv_len != SDCP_PRIVATE_KEY_SIZE)
+  /* BN_num_bytes() drops leading zero bytes, so about 1 in 256 keys is
+   * shorter than SDCP_PRIVATE_KEY_SIZE; pad those instead of failing */
+  if (BN_num_bytes (priv_bn) > SDCP_PRIVATE_KEY_SIZE)
     goto out_error;
 
+  priv_len = SDCP_PRIVATE_KEY_SIZE;
   priv = g_malloc0 (priv_len);
-  if (!BN_bn2bin (priv_bn, priv))
+  if (BN_bn2binpad (priv_bn, priv, priv_len) != priv_len)
     goto out_error;
 
   BN_clear_free (priv_bn);
diff -ru a/libfprint/fpi-sdcp-device.c b/libfprint/fpi-sdcp-device.c
--- a/libfprint/fpi-sdcp-device.c	2026-10-23 00:03:45.881629463 +0900
+++ b/libfprint/fpi-sdcp-device.c	2026-10-23 00:03:57.954435275 +0900
@@ -494,8 +494,6 @@
   action = fpi_device_get_current_action (FP_DEVICE (self));
 
   g_return_if_fail (action == FPI_DEVICE_ACTION_OPEN);
-  g_return_if_fail (priv->host_private_key);
-  g_return_if_fail (priv->host_random);
 
   if (error)
     {
@@ -511,6 +509,21 @@
       return;
     }
 
+  /* Fail the open rather than returning early: an open that never completes
+   * leaves the device claimed until fprintd restarts. */
+  if (!priv->host_private_key || !priv->host_random)
+    {
+      g_clear_pointer (&device_random, g_bytes_unref);
+      g_clear_pointer (&claim, fpi_sdcp_claim_free);
+      g_clear_pointer (&mac, g_bytes_unref);
+
+      fpi_device_open_complete (FP_DEVICE (self),
+                                fpi_device_error_new_msg (FP_DEVICE_ERROR_GENERAL,
+                                                          "SDCP Connect completed without "
+                                                          "host key data"));
+      return;
+    }
+
   if (!device_random || !claim || !mac ||
       (!claim->model_certificate || !claim->device_public_key || !claim->firmware_public_key ||
        !claim->firmware_hash || !claim->model_signature || !claim->device_signature))
